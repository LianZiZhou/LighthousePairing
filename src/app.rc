#include <winver.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,4,0,0
PRODUCTVERSION 0,4,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404B0"
        BEGIN
            VALUE "FileDescription", "Lighthouse Pairing Manager"
            VALUE "ProductName", "LighthousePairing"
            VALUE "FileVersion", LHP_VERSION
            VALUE "ProductVersion", LHP_PRODUCT_VERSION
            VALUE "LegalCopyright", "Copyright (C) 2026 LianZhou. GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
